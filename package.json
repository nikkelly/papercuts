{
  "$schema": "https://json.schemastore.org/package.json",
  "private": true,
  "name": "papercuts",
  "version": "0.2.0",
  "description": "A complaint box for coding agents — opencode and Codex plugins plus a CLI over one append-only JSONL journal per repository",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./journal": "./plugin/src/journal.ts",
    "./tools": "./plugin/src/tools.ts"
  },
  "bin": {
    "papercuts": "./plugin/bin/papercuts.mjs"
  },
  "files": [
    "src",
    "skills",
    "plugin"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "codex",
    "codex-plugin",
    "mcp",
    "ai-agents",
    "papercuts",
    "friction-log",
    "developer-experience"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikkelly/papercuts.git"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "eval:behavioral": "node scripts/eval-behavioral.ts",
    "install:codex": "node scripts/install-codex-plugin.mjs",
    "install:cli": "node scripts/install-cli.mjs",
    "install:opencode": "node scripts/install-opencode.mjs",
    "install:all": "node scripts/install-all.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "dependencies": {
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.21",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/node": "^26.4.1",
    "solid-js": "1.9.12",
    "typescript": "^5.9.2"
  }
}
