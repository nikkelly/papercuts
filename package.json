{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-papercuts",
  "version": "0.1.0",
  "description": "An opencode plugin giving agents a complaint box: log, list, resolve, and remove papercuts in an append-only JSONL journal",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./store": "./src/store.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "dependencies": {
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.21",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
